{% assign product = card_product %}
<article class="pl-glass pl-card"{% if card_attributes %} {{ card_attributes }}{% endif %}>
  <div class="pl-card__shot">
    {% if card_badge != blank %}<span class="pl-pill">{{ card_badge | escape }}</span>{% endif %}
    <a href="{{ product.url }}" class="pl-card__media" aria-label="{{ product.title | escape }}">
      {% if product.featured_image %}
        {{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '240,360,500,700', sizes: '(max-width: 859px) 44vw, 22vw', alt: product.featured_image.alt | default: product.title }}
      {% else %}
        <div class="pl-image-placeholder" role="img" aria-label="{{ product.title | escape }}">No image</div>
      {% endif %}
    </a>
  </div>
  <h3 class="pl-card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
  <div class="pl-card__rate" aria-label="Product rating">
    <b>★ {{ card_rating | default: '4.8' }}</b>
    {% if card_reviews != blank %}<span>· {{ card_reviews | escape }} reviews</span>{% endif %}
  </div>
  <div class="pl-card__price">
    <strong>{{ product.price | money }}</strong>
    {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}
    {% if product.compare_at_price > product.price %}
      {% assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
      <em>{{ discount }}% off</em>
    {% endif %}
  </div>
  {% if product.available %}
    {% form 'product', product, class: 'pl-card__form' %}
      <input type="hidden" name="id" value="{{ product.first_available_variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button class="pl-btn pl-btn--ghost pl-btn--small" type="submit">{{ card_button | default: 'Add to cart' | escape }}</button>
    {% endform %}
  {% else %}
    <button class="pl-btn pl-btn--ghost pl-btn--small" type="button" disabled>Sold out</button>
  {% endif %}
</article>

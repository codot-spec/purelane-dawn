<footer class="purelane-footer" data-scene="4">
  <div class="wrap">
    <div class="fgrid">
      <div class="fcol">
        <a class="brand" href="#top" style="margin-bottom:16px">
          <span class="mark">❧</span>
          <span class="txt"><span class="n1">{{ section.settings.brand_name | escape }}</span><span class="n2">{{ section.settings.brand_tagline | escape }}</span></span>
        </a>
        <p style="max-width:30ch">{{ section.settings.description | escape }}</p>
      </div>
      {% for block in section.blocks %}
        <div class="fcol" {{ block.shopify_attributes }}>
          <h5>{{ block.settings.heading | escape }}</h5>
          {% assign links = block.settings.menu.links %}
          {% if links != blank %}
            {% for link in links %}
              <a href="{{ link.url }}">{{ link.title | escape }}</a>
            {% endfor %}
          {% else %}
            {% if block.settings.link_1_label != blank %}<a href="{{ block.settings.link_1_url | default:'#shop' }}">{{ block.settings.link_1_label | escape }}</a>{% endif %}
            {% if block.settings.link_2_label != blank %}<a href="{{ block.settings.link_2_url | default:'#bundles' }}">{{ block.settings.link_2_label | escape }}</a>{% endif %}
            {% if block.settings.link_3_label != blank %}<a href="{{ block.settings.link_3_url | default:'#proof' }}">{{ block.settings.link_3_label | escape }}</a>{% endif %}
          {% endif %}
        </div>
      {% endfor %}
    </div>
    <div class="fbot">
      <span>© {{ 'now' | date:'%Y' }} {{ section.settings.legal_name | escape }}</span>
      <span>{{ section.settings.legal_links | escape }}</span>
    </div>
  </div>
</footer>
{% schema %}
{
  "name":"11 Footer",
  "tag":"footer",
  "class":"purelane-footer-section",
  "settings":[
    {"type":"text","id":"brand_name","label":"Brand name","default":"Purelane"},
    {"type":"text","id":"brand_tagline","label":"Tagline","default":"Clean, simply"},
    {"type":"textarea","id":"description","label":"Description","default":"Effective cleaning, powered by nature. Made for Indian homes since day one."},
    {"type":"text","id":"legal_name","label":"Legal name","default":"Purelane Eco Products Private Limited"},
    {"type":"text","id":"legal_links","label":"Legal links text","default":"Privacy · Terms · Refunds · Contact"}
  ],
  "blocks":[
    {"type":"column","name":"Footer column","limit":3,"settings":[
      {"type":"text","id":"heading","label":"Heading","default":"Shop"},
      {"type":"link_list","id":"menu","label":"Menu"},
      {"type":"text","id":"link_1_label","label":"Fallback link 1"},
      {"type":"url","id":"link_1_url","label":"Fallback URL 1"},
      {"type":"text","id":"link_2_label","label":"Fallback link 2"},
      {"type":"url","id":"link_2_url","label":"Fallback URL 2"},
      {"type":"text","id":"link_3_label","label":"Fallback link 3"},
      {"type":"url","id":"link_3_url","label":"Fallback URL 3"}
    ]}
  ],
  "presets":[{"name":"11 Footer","blocks":[{"type":"column","settings":{"heading":"Shop"}},{"type":"column","settings":{"heading":"About"}},{"type":"column","settings":{"heading":"Get in touch"}}]}]
}
{% endschema %}

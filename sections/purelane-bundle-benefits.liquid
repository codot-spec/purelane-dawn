<section class="sec" id="{{ section.settings.section_id | escape }}" data-scene="4">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="panel-head">
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
      </div>
      <div class="wb">
        {% for block in section.blocks %}
          <div class="wb-i" {{ block.shopify_attributes }}>
            <span class="ci" aria-hidden="true">
              {% case block.settings.icon %}
                {% when 'money' %}₹
                {% when 'check' %}✓
                {% when 'star' %}★
                {% when 'truck' %}→
              {% endcase %}
            </span>
            <h4>{{ block.settings.title | escape }}</h4>
            <p>{{ block.settings.text | escape }}</p>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name":"07 Why bundles",
  "tag":"section",
  "class":"purelane-benefits-section",
  "settings":[
    {"type":"text","id":"section_id","label":"HTML id","default":"whybundles"},
    {"type":"text","id":"kicker","label":"Kicker","default":"The smarter way to shop"},
    {"type":"text","id":"heading","label":"Heading","default":"Why bundles beat buying single"}
  ],
  "blocks":[
    {"type":"benefit","name":"Benefit","limit":4,"settings":[
      {"type":"select","id":"icon","label":"Icon","options":[{"value":"money","label":"Money"},{"value":"check","label":"Check"},{"value":"star","label":"Star"},{"value":"truck","label":"Truck"}],"default":"money"},
      {"type":"text","id":"title","label":"Title","default":"Save up to 45%"},
      {"type":"text","id":"text","label":"Text","default":"Versus buying the same products separately"}
    ]}
  ],
  "presets":[{"name":"07 Why bundles","blocks":[{"type":"benefit"},{"type":"benefit","settings":{"icon":"check","title":"One flat price","text":"No calculators, no comparing carts"}},{"type":"benefit","settings":{"icon":"star","title":"Curated by experts","text":"Products picked to work well together"}},{"type":"benefit","settings":{"icon":"truck","title":"Free shipping always","text":"Included on every bundle, all India"}}]}]
}
{% endschema %}

<section id="{{ section.settings.section_id | escape }}" class="pl-section pl-bundles" data-scene="3">
  <div class="page-width">
    <div class="pl-glass pl-section-intro">
      <div class="pl-panel-head">
        <span class="pl-kicker">{{ section.settings.kicker | escape }}</span>
        <h2 class="pl-d2">{{ section.settings.heading | escape }}</h2>
        <p class="pl-lede">{{ section.settings.description }}</p>
      </div>
    </div>

    <div class="pl-tiers">
      {% for block in section.blocks %}
        {% assign qty = block.settings.quantity | plus: 0 %}
        {% assign bundle_total = 0 %}
        {% assign bundle_variants = '' %}
        {% assign selected_count = 0 %}
        {% assign unavailable_count = 0 %}
        {% for i in (1..5) %}
          {% assign key = 'component_' | append: i %}
          {% assign p = block.settings[key] %}
          {% if p != blank %}
            {% assign selected_count = selected_count | plus: 1 %}
            {% assign bundle_total = bundle_total | plus: p.price %}
            {% if p.first_available_variant %}
              {% assign bundle_variants = bundle_variants | append: p.first_available_variant.id | append: ',' %}
            {% else %}
              {% assign unavailable_count = unavailable_count | plus: 1 %}
            {% endif %}
          {% endif %}
        {% endfor %}

        {% if selected_count > 0 %}
          {% assign featured = block.settings.featured %}
          <article class="pl-glass pl-tier{% if featured %} is-featured{% endif %}" {{ block.shopify_attributes }}>
            {% if block.settings.tag != blank %}<span class="pl-tier__tag">{{ block.settings.tag | escape }}</span>{% endif %}
            <div class="pl-tierpix{% if selected_count == 5 %} five{% endif %}">
              {% for i in (1..5) %}
                {% assign key = 'component_' | append: i %}
                {% assign p = block.settings[key] %}
                {% if p != blank %}
                  {% if p.featured_image %}
                    {{ p.featured_image | image_url: width: 220 | image_tag: loading: 'lazy', widths: '100,160,220', sizes: '62px', alt: p.featured_image.alt | default: p.title }}
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'pl-image-placeholder' }}
                  {% endif %}
                {% endif %}
              {% endfor %}
            </div>
            <div class="pl-tier__qty">{{ selected_count }}<small>Products</small></div>
            <div class="pl-tier__price">{{ bundle_total | money }}</div>
            {% if block.settings.per_product != blank %}<p class="pl-body-s">{{ block.settings.per_product | escape }}</p>{% endif %}
            <ul>
              {% if block.settings.bullet_1 != blank %}<li><span aria-hidden="true">✓</span>{{ block.settings.bullet_1 | escape }}</li>{% endif %}
              {% if block.settings.bullet_2 != blank %}<li><span aria-hidden="true">✓</span>{{ block.settings.bullet_2 | escape }}</li>{% endif %}
              {% if block.settings.bullet_3 != blank %}<li><span aria-hidden="true">✓</span>{{ block.settings.bullet_3 | escape }}</li>{% endif %}
            </ul>
            {% if unavailable_count == 0 and bundle_variants != blank %}
              <button class="pl-btn {% if featured %}pl-btn--primary{% else %}pl-btn--ghost{% endif %} pl-bundle-add" type="button" data-variant-ids="{{ bundle_variants | escape }}">{{ section.settings.button_label | escape }}{% if featured %}<span aria-hidden="true">→</span>{% endif %}</button>
            {% else %}
              <button class="pl-btn pl-btn--ghost pl-bundle-add" type="button" disabled>Unavailable</button>
            {% endif %}
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<script>
(function(){
  if(window.__purelaneBundleAddBound)return; window.__purelaneBundleAddBound=true;
  document.addEventListener('click',function(e){
    var b=e.target.closest('.pl-bundle-add'); if(!b)return;
    var raw=(b.dataset.variantIds||'').split(',').filter(Boolean);
    if(!raw.length || b.disabled)return;
    var quantities={};
    raw.forEach(function(id){quantities[id]=(quantities[id]||0)+1;});
    var ids=Object.keys(quantities).map(function(id){return {id:Number(id),quantity:quantities[id]};});
    b.disabled=true;
    var root=(window.Shopify && window.Shopify.routes && window.Shopify.routes.root) ? window.Shopify.routes.root : '/';
    fetch(root+'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:ids})})
      .then(function(r){return r.json().then(function(data){if(!r.ok)throw new Error(data.description || data.message || 'Cart add failed'); return data;});})
      .then(function(){window.location.href=root+'cart';})
      .catch(function(error){console.error('Purelane bundle add failed:',error); b.disabled=false;});
  });
})();
</script>

{% schema %}
{
  "name":"04 Bundles",
  "tag":"section",
  "class":"purelane-bundles-section",
  "settings":[
    {"type":"text","id":"section_id","label":"HTML id","default":"bundles"},
    {"type":"text","id":"kicker","label":"Kicker","default":"Build your bundle"},
    {"type":"text","id":"heading","label":"Heading","default":"One box. Every room."},
    {"type":"richtext","id":"description","label":"Description","default":"<p>Choose real Shopify products for each bundle tier.</p>"},
    {"type":"text","id":"button_label","label":"Button label","default":"Build this box"}
  ],
  "blocks":[{"type":"tier","name":"Bundle tier","limit":3,"settings":[
    {"type":"checkbox","id":"featured","label":"Featured","default":false},
    {"type":"text","id":"tag","label":"Tag","default":"Starter"},
    {"type":"text","id":"quantity","label":"Displayed quantity","default":"2"},
    {"type":"text","id":"per_product","label":"Per-product note","default":""},
    {"type":"product","id":"component_1","label":"Component 1"},
    {"type":"product","id":"component_2","label":"Component 2"},
    {"type":"product","id":"component_3","label":"Component 3"},
    {"type":"product","id":"component_4","label":"Component 4"},
    {"type":"product","id":"component_5","label":"Component 5"},
    {"type":"text","id":"bullet_1","label":"Bullet 1","default":""},
    {"type":"text","id":"bullet_2","label":"Bullet 2","default":""},
    {"type":"text","id":"bullet_3","label":"Bullet 3","default":""}
  ]}],
  "presets":[{"name":"04 Bundles","blocks":[{"type":"tier","settings":{"tag":"Starter","quantity":2}},{"type":"tier","settings":{"featured":true,"tag":"Most popular","quantity":3}},{"type":"tier","settings":{"tag":"Whole home","quantity":5}}]}]
}
{% endschema %}

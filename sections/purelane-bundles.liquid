<section id="{{ section.settings.section_id | escape }}" class="pl-section pl-bundles" data-scene="3">
  <div class="page-width">
    <div class="pl-glass pl-section-intro">
      <div class="pl-panel-head">
        <span class="pl-kicker">{{ section.settings.kicker | escape }}</span>
        <h2 class="pl-d2">{{ section.settings.heading | escape }}</h2>
        <p class="pl-lede">{{ section.settings.description }}</p>
      </div>
    </div>

    <div class="pl-tiers">
      {% for block in section.blocks %}
        {% case forloop.index %}
          {% when 1 %}{% assign fb_tag = 'Starter' %}{% assign fb_qty = '2' %}{% assign fb_price = 34900 %}{% assign fb_compare = 59800 %}{% assign fb_note = 'Flat ₹174 per product' %}{% assign fb_b1 = 'Pick any two products' %}{% assign fb_b2 = 'Free shipping across India' %}
          {% when 2 %}{% assign fb_tag = 'Most popular' %}{% assign fb_qty = '3' %}{% assign fb_price = 49900 %}{% assign fb_compare = 89700 %}{% assign fb_note = 'Flat ₹166 per product' %}{% assign fb_b1 = 'Pick any three products' %}{% assign fb_b2 = 'Covers kitchen and laundry' %}{% assign fb_featured = true %}
          {% when 3 %}{% assign fb_tag = 'Whole home' %}{% assign fb_qty = '5' %}{% assign fb_price = 79900 %}{% assign fb_compare = 149500 %}{% assign fb_note = 'Every room in one order' %}{% assign fb_b1 = 'Pick any five products' %}{% assign fb_b2 = 'Free shipping across India' %}
        {% endcase %}
        {% assign bundle = block.settings.product %}
        {% assign qty = block.settings.quantity | default: fb_qty %}
        {% assign qty_int = qty | plus: 0 %}
        {% assign bundle_total = 0 %}
        {% assign bundle_variants = '' %}
        {% assign featured = block.settings.featured | default: fb_featured %}
        <article class="pl-glass pl-tier{% if featured %} is-featured{% endif %}" {{ block.shopify_attributes }}>
          {% assign tag = block.settings.tag | default: fb_tag %}
          {% if tag != blank %}<span class="pl-tier__tag">{{ tag | escape }}</span>{% endif %}
          <div class="pl-tierpix{% if qty_int == 5 %} five{% endif %}">
            {% for i in (1..5) %}
              {% assign key = 'component_' | append: i %}{% assign p = block.settings[key] %}
              {% if p != blank %}{% assign bundle_total = bundle_total | plus: p.price %}{% if p.selected_or_first_available_variant %}{% assign bundle_variants = bundle_variants | append: p.selected_or_first_available_variant.id | append: ',' %}{% endif %}{% endif %}
              {% if p != blank and p.featured_image %}
                {{ p.featured_image | image_url: width: 220 | image_tag: loading: 'lazy', widths: '100,160,220', sizes: '62px', alt: p.title }}
              {% elsif qty_int == 2 and i == 1 %}
                <span class="pimg p-combo2" aria-hidden="true"></span>
              {% elsif i <= qty_int %}
                {% if qty_int == 3 %}{% if i == 1 %}{% assign visual = 'p-kitchen' %}{% elsif i == 2 %}{% assign visual = 'p-tap' %}{% else %}{% assign visual = 'p-dish' %}{% endif %}{% else %}{% case i %}{% when 1 %}{% assign visual = 'p-kitchen' %}{% when 2 %}{% assign visual = 'p-laundry' %}{% when 3 %}{% assign visual = 'p-floor' %}{% when 4 %}{% assign visual = 'p-toilet' %}{% when 5 %}{% assign visual = 'p-handwash' %}{% endcase %}{% endif %}
                <span class="pimg {{ visual }}" aria-hidden="true"></span>
              {% endif %}
            {% endfor %}
          </div>
          <div class="pl-tier__qty">{{ qty }}<small>Products</small></div>
          {% if qty_int == 2 %}{% assign bundle_price = 34900 %}{% elsif qty_int == 3 %}{% assign bundle_price = 49900 %}{% elsif qty_int == 5 %}{% assign bundle_price = 79900 %}{% else %}{% assign bundle_price = fb_price %}{% endif %}
          <div class="pl-tier__price">{{ bundle_price | money }}{% if bundle_total > bundle_price %}<s>{{ bundle_total | money }}</s>{% endif %}</div>
          <p class="pl-body-s">{{ block.settings.per_product | default: fb_note | escape }}</p>
          <ul>
            {% assign bullet1 = block.settings.bullet_1 | default: fb_b1 %}{% assign bullet2 = block.settings.bullet_2 | default: fb_b2 %}
            {% if bullet1 != blank %}<li><span aria-hidden="true">✓</span>{{ bullet1 | escape }}</li>{% endif %}
            {% if bullet2 != blank %}<li><span aria-hidden="true">✓</span>{{ bullet2 | escape }}</li>{% endif %}
            {% if block.settings.bullet_3 != blank %}<li><span aria-hidden="true">✓</span>{{ block.settings.bullet_3 | escape }}</li>{% endif %}
          </ul>
          <button class="pl-btn {% if featured %}pl-btn--primary{% else %}pl-btn--ghost{% endif %} pl-bundle-add" type="button" data-variant-ids="{{ bundle_variants | escape }}">{{ section.settings.button_label | escape }}{% if featured %}<span aria-hidden="true">→</span>{% endif %}</button>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<script>
(function(){
  if(window.__purelaneBundleAddBound)return; window.__purelaneBundleAddBound=true;
  document.addEventListener('click',function(e){
    var b=e.target.closest('.pl-bundle-add'); if(!b)return;
    var ids=(b.dataset.variantIds||'').split(',').filter(Boolean).map(function(id){return {id:Number(id),quantity:1};});
    if(!ids.length)return; b.disabled=true;
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:ids})})
      .then(function(){window.location.href='/cart';}).catch(function(){b.disabled=false;});
  });
})();
</script>

{% schema %}
{
  "name":"04 Bundles",
  "tag":"section",
  "class":"purelane-bundles-section",
  "settings":[
    {"type":"text","id":"section_id","label":"HTML id","default":"bundles"},
    {"type":"text","id":"kicker","label":"Kicker","default":"Build your bundle"},
    {"type":"text","id":"heading","label":"Heading","default":"One box. Every room."},
    {"type":"richtext","id":"description","label":"Description","default":"<p>Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way.</p>"},
    {"type":"text","id":"button_label","label":"Button label","default":"Build this box"}
  ],
  "blocks":[{"type":"tier","name":"Bundle tier","limit":3,"settings":[
    {"type":"product","id":"product","label":"Real bundle product"},
    {"type":"checkbox","id":"featured","label":"Featured","default":false},
    {"type":"text","id":"tag","label":"Tag","default":"Starter"},
    {"type":"text","id":"quantity","label":"Quantity","default":"2"},
    {"type":"text","id":"per_product","label":"Per-product note","default":"Flat price per product"},
    {"type":"product","id":"component_1","label":"Component 1"},
    {"type":"product","id":"component_2","label":"Component 2"},
    {"type":"product","id":"component_3","label":"Component 3"},
    {"type":"product","id":"component_4","label":"Component 4"},
    {"type":"product","id":"component_5","label":"Component 5"},
    {"type":"text","id":"bullet_1","label":"Bullet 1","default":"Pick products for your home"},
    {"type":"text","id":"bullet_2","label":"Bullet 2","default":"Free shipping across India"},
    {"type":"text","id":"bullet_3","label":"Bullet 3","default":"One flat bundle price"}
  ]}],
  "presets":[{"name":"04 Bundles","blocks":[{"type":"tier","settings":{"tag":"Starter","quantity":"2"}},{"type":"tier","settings":{"featured":true,"tag":"Most popular","quantity":"3"}},{"type":"tier","settings":{"tag":"Whole home","quantity":"5"}}]}]
}
{% endschema %}

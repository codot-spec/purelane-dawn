<section class="sec" id="{{ section.settings.section_id | escape }}" data-scene="4">
  <div class="wrap">
    <div class="glass signup rv">
      <span class="kicker">{{ section.settings.kicker | escape }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
      <p class="lede" style="margin:0 auto">{{ section.settings.description | escape }}</p>
      {% form 'customer', class: 'purelane-signup-form' %}
        <input type="hidden" name="contact[tags]" value="purelane-club">
        <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | escape }}" aria-label="Email address" required>
        <button class="btn btn-primary" type="submit">{{ section.settings.button | escape }}</button>
      {% endform %}
      {% if form.posted_successfully? %}<p class="form-status">You're in — check your inbox.</p>{% endif %}
      {% if form.errors %}<p class="form-status">{{ form.errors | default_errors }}</p>{% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"10 Signup",
  "tag":"section",
  "class":"purelane-signup-section",
  "settings":[
    {"type":"text","id":"section_id","label":"HTML id","default":"signup"},
    {"type":"text","id":"kicker","label":"Kicker","default":"Join the Purelane Club"},
    {"type":"text","id":"heading","label":"Heading","default":"Get ₹100 off your first bundle"},
    {"type":"text","id":"description","label":"Description","default":"Plus first access to new launches and restocks."},
    {"type":"text","id":"placeholder","label":"Placeholder","default":"your@email.com"},
    {"type":"text","id":"button","label":"Button","default":"Get my ₹100 off"}
  ],
  "presets":[{"name":"10 Signup"}]
}
{% endschema %}

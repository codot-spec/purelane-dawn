<section class="sec" id="{{ section.settings.section_id | escape }}" data-scene="4">
  <div class="wrap">
    <div class="glass trust rv">
      {% for block in section.blocks %}
        <div class="trust-i" {{ block.shopify_attributes }}>
          <span class="trust-mark" aria-hidden="true">{{ block.settings.mark }}</span>
          <span>{{ block.settings.text | escape | newline_to_br }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"09 Trust bar",
  "tag":"section",
  "class":"purelane-trust-section",
  "settings":[{"type":"text","id":"section_id","label":"HTML id","default":"trust"}],
  "blocks":[
    {"type":"item","name":"Trust item","limit":4,"settings":[
      {"type":"text","id":"mark","label":"Mark","default":"✦"},
      {"type":"text","id":"text","label":"Text","default":"Plant derived\nformulas"}
    ]}
  ],
  "presets":[{"name":"09 Trust bar","blocks":[
    {"type":"item","settings":{"mark":"❧","text":"Plant derived\nformulas"}},
    {"type":"item","settings":{"mark":"▣","text":"Recyclable\npackaging"}},
    {"type":"item","settings":{"mark":"♡","text":"Safe for\nkids & pets"}},
    {"type":"item","settings":{"mark":"◎","text":"Made in\nIndia"}}
  ]}]
}
{% endschema %}

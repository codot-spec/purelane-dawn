<section class="sec" id="{{ section.settings.section_id | escape }}" data-scene="4">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | escape }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="cats">
      {% for block in section.blocks %}
        {% assign p = block.settings.product %}
        {% case forloop.index %}{% when 1 %}{% assign fallback_visual = 'p-kitchen' %}{% when 2 %}{% assign fallback_visual = 'p-toilet' %}{% when 3 %}{% assign fallback_visual = 'p-laundry' %}{% when 4 %}{% assign fallback_visual = 'p-tap' %}{% endcase %}
        <a class="glass cat rv" href="{{ block.settings.link | default: '#combos' }}" {{ block.shopify_attributes }}>
          <span class="ph">
            {% if p != blank and p.featured_image %}
              <span class="pimg" style="height:176px;width:min(80%,180px);background-image:url('{{ p.featured_image | image_url: width: 420 }}');background-size:contain;background-position:center;background-repeat:no-repeat;"></span>
            {% else %}
              <span class="pimg {{ fallback_visual }}" style="height:176px;width:min(80%,180px);" aria-hidden="true"></span>
            {% endif %}
          </span>
          <span class="txt"><h4>{{ block.settings.title | escape }}</h4><p>{{ block.settings.text | escape }}</p></span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name":"08 Bundle categories",
  "tag":"section",
  "class":"purelane-categories-section",
  "settings":[
    {"type":"text","id":"section_id","label":"HTML id","default":"categories"},
    {"type":"text","id":"kicker","label":"Kicker","default":"Bundle categories"},
    {"type":"text","id":"heading","label":"Heading","default":"Find the right bundle for you"}
  ],
  "blocks":[
    {"type":"category","name":"Category","limit":4,"settings":[
      {"type":"product","id":"product","label":"Representative product"},
      {"type":"text","id":"title","label":"Title","default":"Kitchen bundle"},
      {"type":"text","id":"text","label":"Description","default":"Grease, dishes & more"},
      {"type":"url","id":"link","label":"Link"}
    ]}
  ],
  "presets":[{"name":"08 Bundle categories","blocks":[
    {"type":"category","settings":{"title":"Kitchen bundle","text":"Grease, dishes & more"}},
    {"type":"category","settings":{"title":"Bathroom bundle","text":"Deep clean & disinfect"}},
    {"type":"category","settings":{"title":"Laundry bundle","text":"Softer, fresher wash"}},
    {"type":"category","settings":{"title":"Hard water bundle","text":"Melt away limescale"}}
  ]}]
}
{% endschema %}

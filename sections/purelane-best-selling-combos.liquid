<section id="{{ section.settings.section_id | escape }}" class="pl-section pl-combos" data-scene="3">
  <div class="page-width">
    <div class="pl-panel-head">
      <span class="pl-kicker">{{ section.settings.kicker | escape }}</span>
      <h2 class="pl-d2">{{ section.settings.heading | escape }}</h2>
      <div class="pl-rule" aria-hidden="true"><i></i><span>✦</span><i></i></div>
      {% if section.settings.description != blank %}<p class="pl-lede">{{ section.settings.description }}</p>{% endif %}
    </div>

    <div class="pl-comborail" tabindex="0" aria-label="{{ section.settings.aria_label | escape }}">
      {% for block in section.blocks %}
                {% assign combo_total = 0 %}
        {% assign combo_variants = '' %}
        {% assign bundle_price = block.settings.bundle_price | plus: 0 %}
        {% assign selected_count = 0 %}
        {% assign combo_available = true %}
        {% for i in (1..5) %}
          {% assign key = 'product_' | append: i %}
          {% assign component = block.settings[key] %}
          {% if component != blank %}
            {% assign selected_count = selected_count | plus: 1 %}
            {% assign combo_total = combo_total | plus: component.price %}
            {% assign component_variant = component.first_available_variant %}
            {% if component_variant %}
              {% assign combo_variants = combo_variants | append: component_variant.id | append: ',' %}
            {% else %}
              {% assign combo_available = false %}
            {% endif %}
          {% endif %}
        {% endfor %}

        {% if selected_count > 0 %}
          {% assign title = block.settings.title %}
          {% if title == blank %}{% assign title = block.settings.product_1.title %}{% endif %}
          {% assign featured = block.settings.featured %}

          <article class="pl-glass pl-combo{% if featured %} is-featured{% endif %}" {{ block.shopify_attributes }}>
            <div class="pl-combo__tray">
              {% if block.settings.save_label != blank %}<span class="pl-save">{{ block.settings.save_label | escape }}</span>{% endif %}
              {% if block.settings.flag != blank %}<span class="pl-flag">{{ block.settings.flag | escape }}</span>{% endif %}
              <div class="pl-stack">
                {% for i in (1..5) %}
                  {% assign key = 'product_' | append: i %}
                  {% assign caption_key = key | append: '_caption' %}
                  {% assign component = block.settings[key] %}
                  {% assign caption = block.settings[caption_key] %}
                  {% if component != blank %}
                    {% unless forloop.first %}<span class="pl-plus" aria-hidden="true">+</span>{% endunless %}
                    <span class="pl-stack__item">
                      {% if component.featured_image %}
                        {{ component.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '120,180,300', sizes: '70px', alt: component.featured_image.alt | default: component.title }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'pl-image-placeholder' }}
                      {% endif %}
                      {% if caption != blank %}<span>{{ caption | escape }}</span>{% endif %}
                    </span>
                  {% endif %}
                {% endfor %}
              </div>
            </div>

            <div class="pl-combo__body">
              <h3>{{ title | escape }}</h3>
              <div class="pl-count">{{ selected_count }} products</div>
              {% if block.settings.description != blank %}<p>{{ block.settings.description }}</p>{% endif %}

              {% if bundle_price > 0 %}
                {% assign savings = combo_total | minus: bundle_price %}
                <div class="pl-price-row"><strong>{{ bundle_price | money }}</strong>{% if savings > 0 %}<s>{{ combo_total | money }}</s>{% endif %}</div>
                {% if savings > 0 %}<div class="pl-fine">Save {{ savings | money }}</div>{% endif %}
              {% else %}
                <div class="pl-price-row"><strong>{{ combo_total | money }}</strong></div>
              {% endif %}

              <div class="pl-fine">{{ section.settings.fine_print | escape }}</div>
              {% if combo_available and combo_variants != blank %}
                <button class="pl-btn{% if featured %} pl-btn--primary{% else %} pl-btn--ghost{% endif %} pl-bundle-add" type="button" data-variant-ids="{{ combo_variants | escape }}" data-discount-code="{{ block.settings.discount_code | escape }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></button>
              {% else %}
                <button class="pl-btn pl-btn--ghost" type="button" disabled>Currently unavailable</button>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
    <div class="pl-swipecue" aria-hidden="true">→&nbsp; Swipe for more combos</div>
    <p class="pl-railnote">Select the real Shopify products in each combo block. Their images, names and current prices come directly from Shopify.</p>
  </div>
</section>

<script>
(function(){
  if(window.__purelaneBundleAddBound)return; window.__purelaneBundleAddBound=true;
  document.addEventListener('click',function(e){
    var b=e.target.closest('.pl-bundle-add'); if(!b)return;
    var ids=(b.dataset.variantIds||'').split(',').filter(Boolean).map(function(id){return {id:Number(id),quantity:1};});
    var discount=(b.dataset.discountCode||'').trim();
    if(!ids.length)return;
    b.disabled=true;
    fetch(window.Shopify.routes.root + 'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify({items:ids})})
      .then(function(r){return r.json().then(function(data){if(!r.ok)throw new Error(data.description||data.message||'Cart add failed'); return data;});})
      .then(function(){
        if(discount){ window.location.href=window.Shopify.routes.root + 'discount/' + encodeURIComponent(discount) + '?redirect=' + encodeURIComponent(window.Shopify.routes.root + 'cart'); }
        else { window.location.href=window.Shopify.routes.root + 'cart'; }
      })
      .catch(function(err){console.error(err); b.disabled=false; b.setAttribute('aria-label',err.message);});
  });
})();
</script>

{% schema %}
{
  "name":"03 Best-selling combos",
  "tag":"section",
  "class":"purelane-combos-section",
  "settings":[
    {"type":"text","id":"section_id","label":"HTML id","default":"combos"},
    {"type":"text","id":"kicker","label":"Kicker","default":"Pre-built to save you money"},
    {"type":"text","id":"heading","label":"Heading","default":"Best selling combos"},
    {"type":"richtext","id":"description","label":"Description","default":"<p>Swipe through the boxes people order most.</p>"},
    {"type":"text","id":"aria_label","label":"Rail label","default":"Best selling combos"},
    {"type":"text","id":"fine_print","label":"Fine print","default":"Inclusive of all taxes · COD available"},
    {"type":"text","id":"button_label","label":"Button label","default":"Shop bundle"}
  ],
  "blocks":[{"type":"combo","name":"Combo","limit":10,"settings":[
    {"type":"text","id":"bundle_price","label":"Bundle price (₹)","default":"499"},
    {"type":"text","id":"discount_code","label":"Shopify discount code","default":""},
    {"type":"checkbox","id":"featured","label":"Featured","default":false},
    {"type":"text","id":"save_label","label":"Save label","default":""},
    {"type":"text","id":"flag","label":"Flag","default":""},
    {"type":"text","id":"title","label":"Title","default":""},
    {"type":"textarea","id":"description","label":"Description","default":""},
    {"type":"product","id":"product_1","label":"Component 1"},
    {"type":"text","id":"product_1_caption","label":"Component 1 caption","default":""},
    {"type":"product","id":"product_2","label":"Component 2"},
    {"type":"text","id":"product_2_caption","label":"Component 2 caption","default":""},
    {"type":"product","id":"product_3","label":"Component 3"},
    {"type":"text","id":"product_3_caption","label":"Component 3 caption","default":""},
    {"type":"product","id":"product_4","label":"Component 4"},
    {"type":"text","id":"product_4_caption","label":"Component 4 caption","default":""},
    {"type":"product","id":"product_5","label":"Component 5"},
    {"type":"text","id":"product_5_caption","label":"Component 5 caption","default":""}
  ]}],
  "presets":[{"name":"03 Best-selling combos","blocks":[{"type":"combo"},{"type":"combo"},{"type":"combo"},{"type":"combo"}]}]
}
{% endschema %}
